{
	"name": "discord-mcp-server",
	"version": "1.0.0",
	"private": true,
	"description": "Self-hosted MCP server that mirrors one Discord guild into PostgreSQL and answers queries with each user's real Discord permissions",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"format": "prettier --write src tests migrations package.json tsconfig.json tsconfig.test.json docker-compose.yml vitest.config.ts eslint.config.mjs prettier.config.mjs .depcruiser.cjs",
		"lint": "eslint .",
		"arch": "depcruise src --config .depcruiser.cjs",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
		"build": "tsc -p tsconfig.json",
		"test": "vitest run",
		"test:integration": "vitest run --mode integration",
		"migrate": "node-pg-migrate up",
		"migrate:undo": "node-pg-migrate down"
	},
	"dependencies": {
		"@nestjs/common": "11.2.8",
		"@nestjs/core": "11.2.8",
		"@nestjs/platform-express": "11.2.8",
		"@nestjs/swagger": "11.4.8",
		"discord.js": "14.28.1",
		"node-pg-migrate": "9.0.0",
		"pg": "8.23.1",
		"reflect-metadata": "0.2.2",
		"rxjs": "7.8.2"
	},
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@nestjs/testing": "11.2.8",
		"@types/node": "22.20.5",
		"@types/pg": "8.23.1",
		"dependency-cruiser": "18.7.2",
		"eslint": "9.39.5",
		"eslint-config-prettier": "10.1.8",
		"globals": "17.14.0",
		"prettier": "3.9.10",
		"typescript": "5.9.3",
		"typescript-eslint": "8.72.1",
		"vitest": "3.2.7"
	}
}
