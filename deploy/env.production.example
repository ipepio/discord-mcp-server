# Discord MCP Server — production environment template (self-hosted box).
#
# (Named without the `.env` prefix: the local safety guard treats `.env*`
# paths as sensitive. This file contains placeholders only.)
#
# On the box, copy to `.env` (next to docker-compose.prod.yml) and fill in.
# Never commit the filled copy. Deliver secrets to the box through your own
# secret manager or an operator shell — never through chat.
# Every application value is read once at startup and validated; a bad value
# stops the process naming the variable. Source of truth: docs/installation.md.

# --- Compose / database -------------------------------------------------
# POSTGRES_PASSWORD must equal the password inside DATABASE_URL.
POSTGRES_USER=discord_mcp
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=discord_mcp_server

# Image reference; pin an immutable tag or digest for reproducible rollbacks.
APP_IMAGE=ghcr.io/example-owner/discord-mcp-server:latest
# Host port, loopback only. Must match the Discord OAuth redirect.
APP_PORT=3000

# --- Application (required) ---------------------------------------------
# Host MUST be `postgres` (compose service name); the DB port is not published.
DATABASE_URL=postgresql://discord_mcp:CHANGE_ME_STRONG@postgres:5432/discord_mcp_server
DISCORD_CLIENT_ID=CHANGE_ME
DISCORD_CLIENT_SECRET=CHANGE_ME
DISCORD_BOT_TOKEN=CHANGE_ME
DISCORD_GUILD_ID=CHANGE_ME
# Absolute HTTPS origin; must match the Discord redirect prefix exactly.
PUBLIC_BASE_URL=https://hub.example.com
# Absolute session expiry, 300..86400, no renewal.
SESSION_TTL_SECONDS=28800
# full = whole retrievable history; days = rolling window (then set IMPORT_DAYS).
IMPORT_MODE=full
# IMPORT_DAYS=30

# --- Embeddings (required) ----------------------------------------------
EMBEDDING_PROVIDER=openai
# Must be text-embedding-3-small unless EMBEDDING_BASE_URL is set (e.g. an
# OpenAI-compatible gateway you control); dimension must stay 1536.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_API_KEY=CHANGE_ME
# EMBEDDING_BASE_URL=https://<internal-gateway>/v1

# --- Application (optional; defaults shown) ------------------------------
LOG_LEVEL=info
HUB_BRAND_NAME=Discord MCP Server
# HUB_BRAND_MARK_FILE=/srv/app/brand/mark.svg
HUB_UI_LOCALE=es
# Keep false in production (allows http loopback issuer only when true).
AUTHORIZATION_LOCAL_DEVELOPMENT=false
RATE_LIMIT_REGISTER_PER_HOUR=10
RATE_LIMIT_AUTHORIZE_PER_MINUTE=20
RATE_LIMIT_TOKEN_PER_MINUTE=30
RATE_LIMIT_MCP_PER_MINUTE=300
FTS_LANGUAGE=spanish
QUERY_MAX_MESSAGE_CHARS=4000
QUERY_MAX_RESPONSE_BYTES=262144
