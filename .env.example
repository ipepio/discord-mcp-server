# Discord MCP Server — environment template.
# Copy to .env and fill it in. Never commit .env.
# Every variable is documented with its validation in docs/installation.md §2.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Inside docker compose use the service name
# `postgres`; the database port is not published to the host by design.
DATABASE_URL=postgresql://discord_mcp:your-password@postgres:5432/discord_mcp_server

# Discord application credentials (Developer Portal → your app).
DISCORD_CLIENT_ID=your-client-id
DISCORD_CLIENT_SECRET=your-client-secret
DISCORD_BOT_TOKEN=your-bot-token

# The one guild this hub mirrors (Discord Developer Mode → Copy Server ID).
DISCORD_GUILD_ID=your-guild-id

# Origin users and MCP clients reach. http is only valid when
# AUTHORIZATION_LOCAL_DEVELOPMENT=true.
PUBLIC_BASE_URL=http://127.0.0.1:3000

# Hub session lifetime in seconds (300–86400, fixed expiry, no sliding renewal).
SESSION_TTL_SECONDS=3600

# Historical import: `full` mirrors everything retrievable, `days` a window.
IMPORT_MODE=full

# Embeddings endpoint. Provider must be `openai` (the protocol); model and
# dimension must match the migrations' vector column (1536).
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_API_KEY=your-embedding-api-key

# ---------------------------------------------------------------------------
# Required only when IMPORT_MODE=days
# ---------------------------------------------------------------------------

# Messages created strictly after import start − IMPORT_DAYS days are imported.
#IMPORT_DAYS=90

# ---------------------------------------------------------------------------
# Optional (defaults shown; see docs/installation.md §2)
# ---------------------------------------------------------------------------

# Port the app listens on; docker-compose.yml publishes ${APP_PORT}.
#APP_PORT=3000

# Log verbosity: debug, info, warn or error.
#LOG_LEVEL=info

# Product name shown on browser pages, MCP server metadata and the OpenAPI title.
#HUB_BRAND_NAME=Discord MCP Server

# Path to an inline <svg> file replacing the built-in mark on browser pages.
#HUB_BRAND_MARK_FILE=

# Browser text language: es or en.
#HUB_UI_LOCALE=es

# Allows an http://127.0.0.1, http://[::1] or http://localhost issuer.
# Keep false in production.
#AUTHORIZATION_LOCAL_DEVELOPMENT=false

# Per-client-IP rate limits.
#RATE_LIMIT_REGISTER_PER_HOUR=10
#RATE_LIMIT_AUTHORIZE_PER_MINUTE=20
#RATE_LIMIT_TOKEN_PER_MINUTE=30
#RATE_LIMIT_MCP_PER_MINUTE=300

# OpenAI-compatible endpoint root, WITHOUT /embeddings; must not carry
# credentials, a query or a fragment.
#EMBEDDING_BASE_URL=https://api.openai.com/v1

# Full-text dictionary: spanish, english or simple.
#FTS_LANGUAGE=spanish

# Response caps.
#QUERY_MAX_MESSAGE_CHARS=4000
#QUERY_MAX_RESPONSE_BYTES=262144

# Catch-up walker bounds.
#INGESTION_CATCH_UP_ENABLED=true
#INGESTION_CATCH_UP_INTERVAL_MS=300000
#INGESTION_CATCH_UP_CHANNELS_PER_TICK=5
#INGESTION_CATCH_UP_PAGES_PER_CHANNEL_PER_TICK=20
#INGESTION_RESYNC_MAX_PAGES_PER_CHANNEL=5

# ---------------------------------------------------------------------------
# docker compose only (keep identical to the credentials inside DATABASE_URL)
# ---------------------------------------------------------------------------

POSTGRES_USER=discord_mcp
POSTGRES_PASSWORD=your-password
POSTGRES_DB=discord_mcp_server
